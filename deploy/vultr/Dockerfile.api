# Automation Restaurant API (apps/api) for a Vultr VM: the long-running server
# (server.ts), which also runs the background sweeps (provisioning retries,
# low-stock e-mails, recipe costs, attendance). Secrets come from api.env at
# runtime, never from the image.
FROM node:22-bookworm-slim
WORKDIR /repo
COPY . .
RUN npm install --no-audit --no-fund \
 && npm run build:shared \
 && npm run build -w @automation-restaurant/api \
 && npm prune --omit=dev --no-audit --no-fund
ENV NODE_ENV=production PORT=4000
EXPOSE 4000
# provisioning reads supabase/tenant-template/schema.sql from the repo, so it stays in /repo.
CMD ["node", "apps/api/dist/server.js"]
